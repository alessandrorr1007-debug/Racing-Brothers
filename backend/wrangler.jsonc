{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "racing-brothers",
  "main": "src/index.mjs",
  "compatibility_date": "2025-04-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "RACE_ROOMS",
        "class_name": "RaceRoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RaceRoomDO"]
    }
  ],
  "vars": {
    "PROTOCOL_VERSION": "1",
    "ROOM_IDLE_TTL_MS": "900000",
    "RECONNECT_GRACE_MS": "30000",
    "MIN_LAP_DURATION_MS": "5000"
  }
}
